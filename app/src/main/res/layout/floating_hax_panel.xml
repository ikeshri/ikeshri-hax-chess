<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E610111A"
    android:padding="12dp"
    android:elevation="14dp">

    <!-- हेडर बार -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ ikeshri hax"
            android:textColor="#00FFA3"
            android:textStyle="bold"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btnSettingsToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textColor="#7A889B"
            android:textSize="16sp"
            android:padding="2dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2230"
        android:layout_marginVertical="6dp" />

    <!-- लाइव स्टेटस और चाल डिस्प्ले -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#191B26"
        android:padding="8dp"
        android:gravity="center">

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE EYE: ACTIVE"
            android:textColor="#526071"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtNextMove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waiting Move..."
            android:textColor="#00FFA3"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- सेटिंग्स एक्सपैंडेबल मेन्यू -->
    <LinearLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Speed: Instant (300ms)"
            android:textColor="#8892B0"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Engine: Stockfish GM"
            android:textColor="#8892B0"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
