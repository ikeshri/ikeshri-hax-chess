<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. गोल फ्लोटिंग बबल बटन -->
    <LinearLayout
        android:id="@+id/floatingBubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="#E60F172A"
        android:gravity="center"
        android:elevation="14dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♚"
            android:textColor="#00FFA3"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- 2. प्रीमियम डार्क ग्लास पैनल -->
    <LinearLayout
        android:id="@+id/expandedPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F50B0F19"
        android:padding="12dp"
        android:elevation="18dp"
        android:visibility="gone">

        <!-- हेडर बार -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ KESHRI HAX • GM"
                android:textColor="#00FFA3"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/btnClosePanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="18sp"
                android:padding="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginVertical="8dp" />

        <!-- नेविगेशन और बॉडी -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- साइड बार (टैब) -->
            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="#111827"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tabEngine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♟️"
                    android:textSize="20sp"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/tabDev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="20sp"
                    android:padding="4dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- मुख्य डिस्प्ले -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <!-- इंजन व्यू -->
                <LinearLayout
                    android:id="@+id/viewEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENGINE: GM LEVEL 20"
                        android:textColor="#38BDF8"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNextMove"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready"
                        android:textColor="#00FFA3"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Threads: 4 • Depth: High"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- डेवलपर प्रोफाइल व्यू -->
                <LinearLayout
                    android:id="@+id/viewDev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEVELOPER PROFILE"
                        android:textColor="#94A3B8"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnTelegram"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Telegram: @ikeshri"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#0284C7"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btnInstagram"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Instagram: @_ikeshri"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#E11D48"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
